<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="4">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="4">

            <LinearLayout
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight=".5">

                <ImageView
                    android:id="@+id/imagen"
                    android:layout_width="40dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="5dp"
                    android:scaleType="center"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home">

                </ImageView>

            </LinearLayout>

            <LinearLayout
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight="2.9">


                <LinearLayout
                    android:id="@+id/linearlayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/calle"
                            android:layout_width="wrap_content"
                            android:layout_height="29dp"
                            android:layout_marginRight="10dp"
                            android:layout_marginBottom="2dp"
                            android:ellipsize="marquee"
                            android:focusable="false"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="Azulejo"
                            android:textSize="20sp"
                            android:textStyle="bold">

                        </TextView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:text="#"
                            android:textSize="20sp"
                            android:textStyle="bold">

                        </TextView>

                        <TextView
                            android:id="@+id/numero"
                            android:layout_width="wrap_content"
                            android:layout_height="29dp"
                            android:layout_marginBottom="2dp"
                            android:ellipsize="marquee"
                            android:focusable="false"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="80"
                            android:textSize="20sp"
                            android:textStyle="bold">

                        </TextView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/codigoPostal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="4dp"
                            android:ellipsize="marquee"
                            android:focusable="false"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="47899"
                            android:textSize="14sp"
                            android:textStyle="normal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="4dp"
                            android:ellipsize="marquee"
                            android:focusable="false"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="-"
                            android:textSize="14sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/municipio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="4dp"
                            android:ellipsize="marquee"
                            android:focusable="false"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="Ocotlan"
                            android:textSize="14sp"
                            android:textStyle="normal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginRight="4dp"
                            android:ellipsize="marquee"
                            android:focusable="false"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="-"
                            android:textSize="14sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/estado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="marquee"
                            android:focusable="false"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="Jalisco"
                            android:textSize="14sp"
                            android:textStyle="normal" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/Nombre"
                            android:layout_width="wrap_content"
                            android:layout_height="17dp"
                            android:layout_marginRight="4dp"
                            android:layout_marginBottom="2dp"
                            android:ellipsize="marquee"
                            android:focusable="false"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="Oscar Medina"
                            android:textSize="14sp"
                            android:textStyle="bold">

                        </TextView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="4dp"
                            android:ellipsize="marquee"
                            android:focusable="false"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:text="-"
                            android:textSize="14sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/telefono"
                            android:layout_width="wrap_content"
                            android:layout_height="17dp"
                            android:layout_marginBottom="2dp"
                            android:fontFamily="@font/cooperhewitt_heavy"
                            android:text="3319549202"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:focusable="false"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever">

                        </TextView>

                    </LinearLayout>





                </LinearLayout>

            </LinearLayout>



            <LinearLayout
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight="0.6">

                <ImageButton
                    android:id="@+id/eliminar"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:backgroundTint="#00FFFFFF"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:src="@drawable/ic_eliminar">
                </ImageButton>

            </LinearLayout>


            </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="7dp"
            android:orientation="vertical">

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:background="#eee"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginBottom="2dp"
                android:layout_marginTop="9dp"
                android:textColor="#5D40FA"
                android:fontFamily="@font/cooperhewitt_heavy"
                android:text="Editar"
                android:textSize="12sp"
                android:textStyle="bold"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:focusable="false"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever">

            </TextView>

        </LinearLayout>

    </LinearLayout>


    </RelativeLayout>


</androidx.cardview.widget.CardView>